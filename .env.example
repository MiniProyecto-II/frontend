# URL base de la API del backend (sin barra final)
VITE_API_URL=

# Firebase (Configuración del proyecto -> Tus apps -> Web). Son valores públicos del navegador, no secretos.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Opcional: si se define (ej. correounivalle.edu.co) el registro exige ese dominio de correo
VITE_DOMINIO_CORREO=
